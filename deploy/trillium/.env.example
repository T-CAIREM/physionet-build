# HealthDataNexus PoC - Trillium Data Mover Node
# Copy this file to .env and fill in real values before running setup-poc.sh

# ---- PoC Paths --------------------------------------------------------
PROJECT_BASE=/project/def-mmamdani/rutvik26
POC_DIR=/project/def-mmamdani/rutvik26/healthdatanexus-poc
SCRATCH_DIR=/scratch/rutvik26

# ---- Container Images -------------------------------------------------
APP_IMAGE=docker://tcairem/health-data-nexus:a7261253
POSTGRES_IMAGE=docker://postgres:13-alpine
APP_PORT=8000

# ---- Django Core ------------------------------------------------------
SECRET_KEY=change-me-to-a-long-random-string-at-least-50-chars
DJANGO_SETTINGS_MODULE=physionet.settings.production
DEBUG=False
ALLOWED_HOSTS=tri-dm2.scinet.utoronto.ca,localhost,127.0.0.1
SITE_ID=1
SITE_NAME="Health Data Nexus"
STRAPLINE="Enabling health data science"
EMAIL_SIGNATURE="The Health Data Nexus Team"
FOOTER_MANAGED_BY=T-CAIREM
FOOTER_SUPPORTED_BY="SciNet / Compute Canada"

# ---- Database ---------------------------------------------------------
DB_NAME=physionet
DB_USER=physionet
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# ---- Storage ----------------------------------------------------------
STORAGE_TYPE=local
MEDIA_ROOT=/project/def-mmamdani/rutvik26/healthdatanexus-poc/data/media
STATIC_ROOT=/project/def-mmamdani/rutvik26/healthdatanexus-poc/data/static
GCP_MEDIA_BUCKET_NAME=
GCP_STATIC_BUCKET_NAME=

# ---- SciNet / Slurm Workbench -----------------------------------------
ENABLE_LOCAL_RESEARCH_ENVIRONMENTS=True
SCINET_SLURM_ACCOUNT=def-mmamdani
SCINET_PARTITION=compute
SCINET_DEFAULT_WALLTIME=08:00:00
SCINET_MAX_WALLTIME=72:00:00
SCINET_PROJECT_ROOT=/project/def-mmamdani
SCINET_DATASETS_DIR=/project/def-mmamdani/datasets
SCINET_USERS_DIR=/project/def-mmamdani/users
SCINET_SESSIONS_DIR=/project/def-mmamdani/sessions
